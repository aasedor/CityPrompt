# --- Vertex AI (Imagen 3 rendering) ---
VERTEX_AI_PROJECT=your-gcp-project-id
# Path to a GCP service account JSON key file (relative to backend/ or absolute).
# Linked worktrees may keep the same relative file in <git-common-dir>/.
GOOGLE_APPLICATION_CREDENTIALS=vertex-key.json

# --- Optional hosted generation providers ---
GEMINI_API_KEY=
FAL_KEY=
SEEDANCE_VIDEO_TIMEOUT_SECONDS=900

# Optional saved architectural still -> 5s silent Kling animation (server only).
KLING_ANIMATION_ENABLED=false
KLING_ANIMATION_ENDPOINT=fal-ai/kling-video/v3/pro/image-to-video
KLING_ANIMATION_COST_PER_SECOND_USD=0.112
KLING_ANIMATION_CREDIT_COST=50
