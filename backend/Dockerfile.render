FROM python:3.11-slim

# Build from the repository root. Runtime contracts retain their repository paths.
WORKDIR /app/backend

# Install system dependencies for OpenCV, PostGIS, Tesseract, and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .
COPY seed/model-library/rlasm-architectural-clay/house-flex-pilot-v001.json /app/seed/model-library/rlasm-architectural-clay/house-flex-pilot-v001.json

# Copy startup script and make executable
COPY backend/scripts/start.sh /start.sh
RUN sed -i 's/\r$//' /start.sh scripts/start.sh && chmod +x /start.sh

EXPOSE 8000

CMD ["/start.sh"]
