# Copy OUTSIDE the repository; never commit real secrets. Values below are inert.
APP_ENV=production
APP_DEBUG=false
CLASSROOM_RELEASE=true
DIRECT_3D_JOBS_ENABLED=true
CLASSROOM_ASSET_RECEIPT=/release/starter-receipt.json
DATABASE_URL=postgresql+asyncpg://classroom:REPLACE@database:5432/cityprompt
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=https://private-object-storage.example.invalid
S3_BUCKET_NAME=cityprompt-classroom
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
JWT_SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
FRONTEND_URL=https://classroom.example.invalid
ALLOWED_ORIGINS=https://classroom.example.invalid
# The HTTPS edge must restrict access to the internal app proxy.
# Set to the actual trusted proxy IP/subnet, never an unrestricted public range.
FORWARDED_ALLOW_IPS=127.0.0.1

# Exact exports work while paid images are paused. Choose funding BEFORE enabling.
DIRECT_3D_IMAGES_ENABLED=false
OPENAI_API_KEY=
RENDER_GLOBAL_DAILY_TOKEN_CAP=0
DIRECT_3D_QUEUE_LIMIT=16
DIRECT_3D_PROJECT_QUEUE_LIMIT=2
DIRECT_3D_QUEUE_TIMEOUT_SECONDS=900
DIRECT_3D_RECOVERY_SECONDS=900

# Restrict Maps keys to the selected origin and APIs; set provider quotas/alerts.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Deferred paid providers must stay blank in the first classroom profile.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
STABILITY_API_KEY=
FAL_KEY=
VERTEX_AI_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
LAYOUT_AI_PROVIDER=none

# Configure a working reset-email sender for the chosen host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
# OAuth is optional. Register exact HTTPS callbacks before enabling a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://classroom.example.invalid/api/v1/auth/oauth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://classroom.example.invalid/api/v1/auth/oauth/microsoft/callback
