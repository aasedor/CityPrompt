    {
      "id": "geometry_carries_identity",
      "rule": "Silhouette-changing and shadow-casting features are geometry. A facade photograph must not be asked to hide generic massing."
    },
    {
      "id": "fixed_ends_repeat_middle",
      "rule": "Keep corner, entrance, podium, crown and roof assemblies fixed. Repeat or stretch only authored middle bays."
    },
    {
      "id": "details_wrap",
      "rule": "Author front, left, right and rear elevations for every asset, including courtyard walls. Material courses, cornices, balconies, window returns and roof logic continue around exposed sides and corners; secondary elevations remain stylistically related but use a believable different opening and service hierarchy. Detail may be occluded only when site geometry confirms a true party wall."
    },
    {
      "id": "reference_plan_voids_are_geometry",
      "rule": "Courtyards, quadrangles, light wells and gate passages visible in an authoritative roof or aerial reference are fixed plan geometry. They may not survive only as metadata inside an otherwise solid massing core."
    },
    {
      "id": "roof_topology_comes_from_aerial_evidence",
      "rule": "Infer ridge axis, valleys, cross-gables, hips, green-roof drainage and photovoltaic layout from compatible 60-degree and 90-degree references. Catalogue roof labels are hints, not sufficient construction evidence."
    },
    {
      "id": "silhouette_gate_is_regression_not_approval",
      "rule": "Use a camera-locked OpenCV silhouette, roofline and aspect-ratio contract to catch gross drift, but never treat its pass as likeness approval. Pair it with explicit landmark hierarchy and roof-plan checks because an incorrect solid box can share the correct outer boundary."
    },
    {
      "id": "vernacular_openings_are_audited_before_geometry",
      "rule": "Weathered timber grain, murals, flower boxes and masonry joints are not glazing evidence. For irregular vernacular elevations, use an audited opening schedule before creating physical panes or frames; automatic masks remain texture-only evidence until reviewed."
    }
  ],
