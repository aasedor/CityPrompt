      "commit": "454657070",
      "lesson": "clean precast construction plus atomic opening cards"
    }
  ],
  "bounded_correction_policy": {
    "cosmetic_only_debt_may_be_disclosed": true,
    "genuine_3d_failure_action": "quarantine",
    "maximum_focused_correction_loops": 2,
    "pilot_count": 1,
    "open_ended_generation_loop_allowed": false
  },
  "card_taxonomy": {
    "material_swatch": {
      "constraints": [
        "seamless",
        "orthographic",
        "even_lighting",
        "world_scale_capable"
      ],
      "use": "broad brick, stone, siding, metal, roof, or glass surfaces"
    },
    "object_card": {
      "constraints": [
        "isolated_object",
        "neutral_background",
        "no_people",
        "no_text",
        "no_cast_shadow",
        "no_adjacent_objects"
      ],
      "use": "unique dome, spire, monitor, chimney, canopy, bridge part, ornament, or trim assembly"
    },
    "occupied_depth_card": {
      "constraints": [
        "behind_physical_glazing",
        "behind_physical_mullions",
        "never_on_exterior_face"
      ],
      "use": "interior signal behind glazing"
    },
    "opening_card": {
      "constraints": [
        "one_opening_only",
        "no_adjacent_facade",
        "aligned",
        "perspective_free"
      ],
      "use": "single window, door, storefront, dormer, or occupied-depth view"
    }
  },
  "hard_stops": [
    "wrong_archetype_or_sibling_identity",
    "missing_unique_role",
    "missing_required_card",
    "generic_fallback",
    "whole_facade_photo_used_as_material",
    "whole_object_card_repeated_on_component_faces",
    "bricked_printed_or_flat_opening",
    "missing_physical_opening_depth",
    "incomplete_identity_defining_roof_dome_bridge_or_system",
    "leak_ghost_zfight_stretch_duplicate_stack_broken_glass_or_lost_parallax",
    "review_image_not_rendered_from_actual_3d_model",
    "scale_started_before_pilot_approval"
  ],
  "invariants": {
    "actual_3d_render_required_for_review": true,
    "broad_surface_world_scale_material_required": true,
    "compound_object_card_repeated_on_child_faces_forbidden": true,
    "generic_fallback_allowed": false,
    "git_review_handoff_required": true,
    "image_generation_scope": "clean reference-matched cards and material swatches only",
    "non_overwriting_candidates_required": true,
    "physical_opening_depth_required": true,
    "same_semantic_role_card_reuse_allowed": true,
    "unique_role_requires_card": true,
    "user_visual_approval_before_scale": true,
    "whole_facade_photo_material_forbidden": true
  },
  "name": "Reference-Locked Atomic Sticker Method",
