    "reviewer_ignores_metadata_as_visual_proof": true,
    "severity_definitions": {
      "p0": "A source-identity, topology, envelope, opening, contact, program, camera, provenance, or lifecycle defect that invalidates the candidate or its proof.",
      "p1": "A clearly visible fidelity, material, optical, finish, landscape, or coherence defect that prevents production-quality keeper approval.",
