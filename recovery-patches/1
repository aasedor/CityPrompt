From d14904f509fecc614d7a34a77bce7b279788af02 Mon Sep 17 00:00:00 2001
From: aasedor <andrew.sedor@gmail.com>
Date: Sun, 19 Jul 2026 23:28:19 -0600
Subject: [PATCH 01/32] fix: stabilize local frontend startup

---
 docker-compose.yml     | 5 ++++-
 frontend/.dockerignore | 7 +++++++
 2 files changed, 11 insertions(+), 1 deletion(-)
 create mode 100644 frontend/.dockerignore

diff --git a/docker-compose.yml b/docker-compose.yml
index 968801e3424b407cc39986689876827910be1335..563938564692a9071df036da83ac292578ba6850 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -131,7 +131,10 @@ services:
       - VITE_FAL_KEY=${VITE_FAL_KEY:-}
       - VITE_SENTRY_DSN=${SENTRY_DSN_FRONTEND:-}
     ports:
-      - "5175:5174"
+      # Bind explicitly to IPv4. On Windows + Docker Desktop, the published
+      # IPv6 localhost listener can accept the connection but never proxy a
+      # response, which leaves http://localhost:5175 hanging indefinitely.
+      - "127.0.0.1:5175:5174"
     volumes:
       - ./frontend:/app
       - /app/node_modules
diff --git a/frontend/.dockerignore b/frontend/.dockerignore
new file mode 100644
index 0000000000000000000000000000000000000000..d2bc2df10b025a85f020dcbdfb91d80aaa4f1da7
--- /dev/null
+++ b/frontend/.dockerignore
@@ -0,0 +1,7 @@
+node_modules/
+dist/
+coverage/
+.vite/
+*.log
+.env
+.env.*
-- 
2.55.0.windows.2

