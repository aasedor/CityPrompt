+import { describe, expect, it } from 'vitest';
+
+import {
+  MAX_PARK_MICRODETAIL_CANDIDATES_PER_KIND,
+  MAX_PARK_MICRODETAIL_ELEMENTS_PER_PLACEMENT,
+  MAX_PARK_MICRODETAIL_PLACEMENTS,
+  MAX_PARK_MICRODETAIL_STATIONS_PER_SOURCE,
