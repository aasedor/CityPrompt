+      <meshStandardMaterial color={color} roughness={roughness} metalness={metalness} />
+    </instancedMesh>
+  );
+}
+
+function poseTransform(
+  placement: StreetFixturePose,
+  z: number,
+  scaleX: number,
+  scaleY: number,
+  scaleZ: number,
+): InstanceTransform {
+  return {
+    x: placement.x,
+    y: placement.y,
+    z,
+    yawRad: placement.yawRad,
+    scaleX,
+    scaleY,
+    scaleZ,
+  };
+}
+
+export function GlobeStreetMicrodetailInstances({
+  fixtures,
+  fixtureMetalColor,
+  renderOrder,
+}: {
