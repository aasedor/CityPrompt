+    geometry.translate(0, 0, 0.42);
+    return geometry;
+  }, []);
+  const shrub = useMemo(() => new THREE.DodecahedronGeometry(0.5, 1), []);
+  useEffect(() => () => {
+    box.dispose();
+    cylinder.dispose();
+    rack.dispose();
+    shrub.dispose();
+  }, [box, cylinder, rack, shrub]);
