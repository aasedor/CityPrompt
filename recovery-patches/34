+    poseTransform(
+      placement,
+      placement.z + PUBLIC_REALM_STREET_ROAD_SURFACE_LIFT_METERS + placement.heightM / 2,
+      placement.radiusM,
+      placement.radiusM,
+      placement.heightM,
