+        "schema_version": PUBLIC_REALM_SCHEMA_VERSION,
+        "family_id": capability.family_id,
+        "family_version": capability.family_version,
+        "kind": capability.kind,
+        "generator": capability.generator,
+        "archetype_id": selection.archetype_id,
