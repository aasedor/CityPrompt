+
+  it('does not coerce a six-arm crossing into the four-arm contract', () => {
+    const nodes = detectFourWayStreetIntersections([
+      street('east-west', [[-114.1, 51], [-114.09, 51]], 22),
+      street('north-south', [[-114.095, 50.995], [-114.095, 51.005]], 14),
