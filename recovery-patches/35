+  const base = positions.length / 3;
+  const innerX = centerX - outward.x * depth / 2;
+  const innerY = centerY - outward.y * depth / 2;
+  const outerX = centerX + outward.x * depth / 2;
+  const outerY = centerY + outward.y * depth / 2;
