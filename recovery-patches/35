+    expect(local.sourceArchetypeIds).toEqual(expect.arrayContaining([
+      'yield_street', 'narrow_residential_street', 'woonerf_shared_street',
+      'green_alley', 'toronto_laneway', 'calgary_local', 'multi_use_trail',
+    ]));
