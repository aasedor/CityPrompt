+  it('exposes only the four versioned executable pilot families', () => {
+    expect(Object.keys(PUBLIC_REALM_STREET_FAMILIES).sort()).toEqual([
+      'street_compact_roundabout',
+      'street_complete_main_22m',
+      'street_four_way_intersection',
