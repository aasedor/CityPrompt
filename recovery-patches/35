+                f"'{request.archetype_id}'.",
+                code="family_incompatible",
+                requested=_request_payload(request),
+                supported_families=[_family_summary(capability)],
+                violations=[{
+                    "field": "variant_id",
+                    "requested": request.variant_id,
+                    "supported": sorted({
