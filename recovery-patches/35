+        min_width_m=width[0],
+        max_width_m=width[1],
+        min_depth_m=depth[0],
+        max_depth_m=depth[1],
+        min_area_m2=area[0],
+        max_area_m2=area[1],
+        min_aspect_ratio=min_aspect_ratio,
