+function appendQuad(
+  positions: number[],
+  indices: number[],
+  centerX: number,
+  centerY: number,
+  axisX: LocalPt,
+  axisY: LocalPt,
+  halfX: number,
+  halfY: number,
+  z: number,
+): void {
+  const base = positions.length / 3;
+  positions.push(
+    centerX - axisX.x * halfX - axisY.x * halfY,
+    centerY - axisX.y * halfX - axisY.y * halfY,
+    z,
+    centerX + axisX.x * halfX - axisY.x * halfY,
+    centerY + axisX.y * halfX - axisY.y * halfY,
+    z,
+    centerX + axisX.x * halfX + axisY.x * halfY,
+    centerY + axisX.y * halfX + axisY.y * halfY,
+    z,
+    centerX - axisX.x * halfX + axisY.x * halfY,
+    centerY - axisX.y * halfX + axisY.y * halfY,
+    z,
+  );
+  indices.push(base, base + 1, base + 2, base, base + 2, base + 3);
