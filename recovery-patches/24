+        "status": "OK",
+        "predictions": [
+            {"place_id": "place-1", "description": "2448 31 Ave SW, Calgary, AB, Canada"},
+            {"place_id": "place-2", "description": "2448 31 Ave NW, Edmonton, AB, Canada"},
+        ],
+    })
+
+    response = await client.get("/api/v1/geocoding/autocomplete", params={"q": "2448 31"})
