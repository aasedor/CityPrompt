+    assert response.status_code == 200
+    assert response.json() == {
+        "suggestions": [
+            {"id": "place-1", "place_name": "2448 31 Ave SW, Calgary, AB, Canada"},
+            {"id": "place-2", "place_name": "2448 31 Ave NW, Edmonton, AB, Canada"},
