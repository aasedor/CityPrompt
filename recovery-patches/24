+async def test_resolve_returns_coordinates_for_selected_place(client, monkeypatch):
+    monkeypatch.setattr(
+        geocoding,
+        "get_settings",
+        lambda: SimpleNamespace(google_maps_api_key="maps-key", gemini_api_key=""),
