+        mode="RGB",
+    )
+    mask = Image.new("L", size, 0)
+    ImageDraw.Draw(mask).rectangle(
+        (width // 4, height // 4, width * 3 // 4, height * 3 // 4),
+        fill=255,
+    )
+    return beauty, mask
