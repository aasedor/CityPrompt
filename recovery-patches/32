+            },
+        },
+    )
+
+    original = community_3d_representation_hash(
+        kind="building",
+        generator="lego_assembly",
+        source_hash=source_hash,
+        building=building,
+    )
+    assert original is not None
+    assert community_3d_representation_hash(
+        kind="building",
+        generator="lego_assembly",
