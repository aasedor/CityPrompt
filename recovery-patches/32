+def _zone(
+    zone_id: uuid.UUID,
+    zone_type: str,
+    *,
+    properties: dict | None = None,
+    building_id: uuid.UUID | None = None,
+):
+    return SimpleNamespace(
+        id=zone_id,
+        zone_type=zone_type,
+        properties=properties or {},
+        geometry=from_shape(box(-114.08, 51.04, -114.079, 51.041), srid=4326),
